{
  "cloudFunctions": {
    "nodejs": {
      "externalNodeModules": [
        "mongodb",
        "jsonwebtoken",
        "bcryptjs",
        "cos-nodejs-sdk-v5"
      ],
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}