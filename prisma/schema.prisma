generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Message {
  id         Int       @id @default(autoincrement())
  username   String
  content    String
  img        String?
  ip         String?
  ipLocation String?
  dream      String?
  userImg    String?
  reply      String?
  replytime  DateTime?
  posttime   DateTime  @default(now())

  @@index([posttime])
  @@index([username])
}

model Blacklist {
  id        Int      @id @default(autoincrement())
  ip        String
  createdAt DateTime @default(now())
}
